# Alpaca paper account keys (dashboard > Paper Trading > API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Where market data is stored
DB_PATH=data/trade_away.db

# Crypto pairs to stream (comma separated, Alpaca format)
CRYPTO_SYMBOLS=BTC/USD,ETH/USD

# Universe screen: liquid US stocks and ETFs only
MIN_PRICE=5
MIN_DOLLAR_VOLUME=20000000

# Free Basic plan allows 30 symbols on the stock websocket
MAX_STREAM_SYMBOLS=30

# Public trade tracker (`trade-away publish`): a fine-grained GitHub token with
# "Contents: Read and write" on sashu1999/trade-away only.
PAGES_TOKEN=

# Missed-run alerts (optional, free): make a check at healthchecks.io for each
# job, paste its ping URL here, and connect Telegram or email in Healthchecks.
# It alerts when a run fails or doesn't happen on schedule.
HEALTHCHECK_RUN_URL=
HEALTHCHECK_PUBLISH_URL=

# News bot (record-only): a free key from console.groq.com. Without it the bot skips.
GROQ_API_KEY=
NEWS_MODEL=openai/gpt-oss-20b
