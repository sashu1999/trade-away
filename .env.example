# Alpaca paper account keys (dashboard > Paper Trading > API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Where market data is stored
DB_PATH=data/trade_away.db

# Crypto pairs to stream (comma separated, Alpaca format)
CRYPTO_SYMBOLS=BTC/USD,ETH/USD

# Universe screen: liquid US stocks and ETFs only
MIN_PRICE=5
MIN_DOLLAR_VOLUME=20000000

# Free Basic plan allows 30 symbols on the stock websocket
MAX_STREAM_SYMBOLS=30
